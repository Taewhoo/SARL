# NOTE (sumanthrh): We add .venv/ to gitignore here so that ray doesn't export .venv folder in the working directory
.venv/

# Exclude common Python artifacts from the Ray working directory
__pycache__/
*.pyc
.pytest_cache/
build/
dist/
*.egg-info/

# Exclude large data/output dirs from Ray working_dir upload
outputs/
wandb/
logs/
train_data/
*.arrow
*.log
